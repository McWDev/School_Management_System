# Copy to .env.local for local development. Never commit real values.
# With the Neon CLI, `neon checkout development` (or `neon env pull`) fills
# DATABASE_URL, DATABASE_URL_UNPOOLED and NEON_BRANCH for you.

# Pooled Neon connection string (hostname contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) connection string. Used only for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
# Neon branch name, informational.
NEON_BRANCH=development

# Public base URL of the app.
APP_URL=http://localhost:3000

# Session signing secret, required from Task 05 (custom authentication).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value
