# Copy to .env.local for local development. Never commit real values.
# With the Neon CLI, `neon checkout development` (or `neon env pull`) fills
# DATABASE_URL, DATABASE_URL_UNPOOLED and NEON_BRANCH for you.

# Pooled Neon connection string (hostname contains "-pooler"). Used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) connection string. Used only for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
# Neon branch name, informational.
NEON_BRANCH=development

# Public base URL of the app.
APP_URL=http://localhost:3000

# Authentication (Task 05). Required: SESSION_SECRET, at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value
# Optional session policy (defaults shown): idle timeout and absolute lifetime.
# SESSION_IDLE_TIMEOUT_MINUTES=480
# SESSION_MAX_AGE_HOURS=168
# Optional: login attempts per IP per 15 minutes (default 50).
# AUTH_LOGIN_IP_LIMIT=50
# Optional: force Secure cookies on/off (default: on in production).
# AUTH_COOKIE_SECURE=true

# Development only: password for synthetic demo users created by npm run db:seed.
SEED_USER_PASSWORD=choose-a-dev-password
